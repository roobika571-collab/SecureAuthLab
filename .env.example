# SecureAuth Lab - Environment Configuration Template
# Copy this file to .env before starting the server in development or production.
# NEVER commit the real .env file with active secrets to version control.

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True

# Cryptographic Secret Key for session signing and CSRF tokens
# Generate a strong key in production using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev_insecure_secret_key_replace_in_production_99a8b7c6d5e4f3a2

# Cookie Security Settings
# Set to 'True' when deploying over HTTPS. Must remain 'False' only for local HTTP development.
SESSION_COOKIE_SECURE=False

# Session Timeout Policy (Inactivity Lifetime in minutes)
# Default is 20 minutes of inactivity before automatic session termination.
SESSION_TIMEOUT_MINUTES=20

# Rate Limiting Configuration (Flask-Limiter)
# Formats: "X per minute", "Y per hour", etc.
LOGIN_RATE_LIMIT=5 per minute
REGISTER_RATE_LIMIT=3 per minute

# Rate Limiting Storage Backend
# In local development: memory:// (in-memory per single worker)
# In production multi-worker deployment: redis://localhost:6379/0 or memcached://localhost:11211
RATELIMIT_STORAGE_URI=memory://

# Database Configuration
DATABASE_PATH=secureauth.db
